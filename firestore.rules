rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDefaultAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'admin@scenvy.de' ||
        request.auth.token.email.lower() == 'web.domell@gmail.com' || request.auth.token.email.lower() == 'web.domain@gmail.com'
      );
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        isDefaultAdminEmail() ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }

    function getUserTenantId() {
      return hasUserDoc() && ('tenant_id' in getUserData())
        ? getUserData().tenant_id
        : ('tenant_' + request.auth.uid);
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        isAdmin() ||
        tenantId == getUserTenantId()
      );
    }

    // User profiles: users can only read/update their own profile, admins can manage all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Tenants: self-registration is locked to 'starter' plan; updates cannot escalate plan without admin
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (isTenantMember(tenantId) || isAdmin());
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.plan == 'starter' && request.resource.data.status in ['trial', 'active'])
      );
      allow update: if isAdmin() || (
        isTenantMember(tenantId) && 
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    // Reels: Public read for guest display & QR scans; tenant-scoped writes
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.tenant_id == getUserTenantId() ||
        request.resource.data.tenantId == getUserTenantId()
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.tenant_id == getUserTenantId() ||
        resource.data.tenantId == getUserTenantId()
      );
    }

    // Locations: Public read for venue lookup & guest view; tenant-scoped writes
    match /locations/{locationId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.tenant_id == getUserTenantId() ||
        request.resource.data.tenantId == getUserTenantId() ||
        locationId == 'dt-demo'
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.tenant_id == getUserTenantId() ||
        resource.data.tenantId == getUserTenantId() ||
        locationId == 'dt-demo'
      );
    }

    // Digital Menus: Public read for menu reel view; tenant-scoped writes
    match /menus/{menuId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.tenant_id == getUserTenantId() ||
        request.resource.data.tenantId == getUserTenantId()
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.tenant_id == getUserTenantId() ||
        resource.data.tenantId == getUserTenantId()
      );
    }

    // Analytics (Scans & Clicks)
    match /scans/{scanId} {
      allow read: if isAuthenticated();
      allow create: if true;
    }

    match /clicks/{clickId} {
      allow read: if isAuthenticated();
      allow create: if true;
    }

    // System & Platform Configuration: Secrets/platform protected (admin only); public configs readable
    match /system_config/{configId} {
      allow read: if configId in ['landing', 'pricing', 'public'] || isAdmin();
      allow write: if isAdmin();
    }

    // Domain Authorization & Custom Domains Registry
    match /domains/{domainId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.tenant_id == getUserTenantId()
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.tenant_id == getUserTenantId()
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.tenant_id == getUserTenantId()
      );
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

